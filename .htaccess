Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/v1/?(.*)$ api/index.php/$1 [QSA,L]
    RewriteRule ^(?:config|vendor|\.git|\.vs)(?:/|$) - [F,NC,L]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

<FilesMatch "^(?:composer\.(?:json|lock)|script\.sql)$">
    Require all denied
</FilesMatch>
